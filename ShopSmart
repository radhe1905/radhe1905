  <script>
 // SEARCH FUNCTION WITH AUTO RESET AND FLASH
const allProducts = document.querySelectorAll('.product-grid .card');
let lastHighlighted = null;

document.querySelector('.search-bar input').addEventListener('keydown', function(e) {
  if (e.key === 'Enter') {
    const query = e.target.value.trim().toLowerCase();
    if (!query) return;

    // Reset previous highlight
    if (lastHighlighted) {
      lastHighlighted.style.order = '';
      lastHighlighted.style.border = '1px solid #ddd';
      lastHighlighted.classList.remove('highlight-flash');
      lastHighlighted = null;
    }

    // Search locally
    let found = false;
    allProducts.forEach(card => {
      const title = card.querySelector('h2').innerText.toLowerCase();
      if (title.includes(query)) {
        card.style.order = '-1';
        card.style.border = '2px solid #ff6f61';
        card.scrollIntoView({ behavior: 'smooth', block: 'center' });
        card.classList.add('highlight-flash'); // add flash effect
        lastHighlighted = card;
        found = true;
      }
    });

    // If not found locally, show Amazon/Flipkart links
    if (!found) {
      const amazonSearch = `https://www.amazon.in/s?k=${encodeURIComponent(query)}`;
      const flipkartSearch = `https://www.flipkart.com/search?q=${encodeURIComponent(query)}`;
      showSearchResults(`
        <p>No local products found for "<b>${query}</b>".</p>
        <p>Check online:</p>
        <a href="${flipkartSearch}" target="_blank" style="color:#ff6f61; font-weight:bold;">Flipkart</a> | 
        <a href="${amazonSearch}" target="_blank" style="color:#ff6f61; font-weight:bold;">Amazon</a>
      `);
    } else {
      const resultsDiv = document.getElementById('searchResults');
      if (resultsDiv) resultsDiv.innerHTML = '';
    }
  }
});
function showSearchResults(html) {
  let resultsDiv = document.getElementById('searchResults');
  if (!resultsDiv) {
    resultsDiv = document.createElement('div');
    resultsDiv.id = 'searchResults';
    document.body.insertBefore(resultsDiv, document.body.firstChild);
  }
  resultsDiv.innerHTML = html;
}
  </script>
